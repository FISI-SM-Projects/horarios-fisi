# Servidor Centralizado de Identidad (Keycloak 26 FISI)
KEYCLOAK_URL=http://aulavirtual.local/auth
KEYCLOAK_REALM=aula-virtual-fisi-pregrado-dev
KEYCLOAK_CLIENT_ID=sagd-horario-docentes
KEYCLOAK_CLIENT_SECRET=tu_client_secret_aqui

# Secreto de cifrado para la cookie de sesión BFF (mínimo 32 caracteres)
AUTH_SESSION_SECRET=desarrollo_secreto_super_seguro_fisi_32_chars

# Base de datos PostgreSQL v18
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/horarios_fisi
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/horarios_fisi_test

# Docker Compose
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=horarios_fisi
POSTGRES_PORT=5432
APP_PORT=3000
